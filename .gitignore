# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.env
.venv
env/
venv/
ENV/

# Temporary Office lock files
~$*

# Logs
*.log
logs/*.log

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Sensitive tokens & OAuth credentials
*.pickle
credentials.json
token.json

# Generated documents & test outputs
desktop_app/output/*
!desktop_app/output/.gitkeep
desktop_app/database/hrms.db
desktop_app/database/*.db

# Ignore all legacy root items, keep only desktop_app, .gitignore, and launchers
/*
!/desktop_app/
!/.gitignore
!/Launch_DFY_HRMS.bat
!/Install_Dependencies.bat
!/README.md
!/requirements.txt
